{
  "name": "lip-cursor-sdk-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Plugin-owned Cursor SDK NDJSON bridge for the aiproxer-cursor-sdk cursorsdk backend plugin",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "lip-cursor-sdk-bridge": "bin/lip-cursor-sdk-bridge.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin/**",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/*.test.ts\"",
    "live-probe": "tsx src/liveProbe.ts",
    "live-scenarios": "tsx src/liveScenarios.ts"
  },
  "dependencies": {
    "@cursor/sdk": "1.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "npm": "12.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "6.29.1"
  }
}
